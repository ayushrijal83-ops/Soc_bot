# Social Publisher (SOC_BOT) - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///data/publisher.db

# Encryption key for token storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ============================================================
# INSTAGRAM (Meta / Facebook)
# ============================================================
# Get from: https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/callback/instagram

# ============================================================
# TIKTOK
# ============================================================
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback/tiktok

# ============================================================
# YOUTUBE (Google)
# ============================================================
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/callback/youtube

# ============================================================
# APPLICATION
# ============================================================
LOG_LEVEL=INFO
DRY_RUN=false

# Optional: Override callback port (default 8080)
# CALLBACK_PORT=8080

# Optional: Max concurrent uploads (default 3)
# MAX_CONCURRENT_UPLOADS=3

# Optional: Video validation limits (bytes)
# MAX_VIDEO_SIZE_INSTAGRAM=4294967296
# MAX_VIDEO_SIZE_TIKTOK=4294967296
# MAX_VIDEO_SIZE_YOUTUBE=274877906944