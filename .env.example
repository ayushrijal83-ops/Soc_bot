# Social Publisher (SOC_BOT) - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///data/publisher.db

# Encryption key for token storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ============================================================
# INSTAGRAM (Instagram API with Instagram Login)
# ============================================================
# App Dashboard -> Instagram -> API setup with Instagram login.
# Use the INSTAGRAM app ID/secret shown THERE. The Meta App ID/secret from App settings -> Basic
# do NOT work (instagram.com shows "Sorry, this page isn't available"; token endpoint: "Invalid platform app").
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Required: EXACTLY one of the OAuth redirect URIs registered in Business login settings.
# Recommended (paste mode):  https://ayushrijal83-ops.github.io/Soc_bot/oauth/instagram-callback.html
# Local mode (if Meta accepts http): http://127.0.0.1:8765/callback/instagram
INSTAGRAM_REDIRECT_URI=

# ============================================================
# TIKTOK
# ============================================================
# Get from: https://developers.tiktok.com/  (see docs/API_INTEGRATIONS.md -> TikTok setup)
# App products: Login Kit (platform: Desktop) + Content Posting API (Direct Post enabled).
# Scopes requested: user.info.basic, video.publish
# Unaudited apps can only post SELF_ONLY (private) -- set the test TikTok account to private.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Leave blank for a dynamic port; register exactly http://127.0.0.1:*/callback/tiktok in Login Kit.
TIKTOK_REDIRECT_URI=

# ============================================================
# YOUTUBE (Google)
# ============================================================
# Get from: https://console.cloud.google.com/apis/credentials (OAuth client type: Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Leave blank: Google loopback flow uses a random free port (http://127.0.0.1:<port>/callback/youtube).
YOUTUBE_REDIRECT_URI=

# ============================================================
# INSTAGRAM TEMPORARY MEDIA STORAGE (private S3-compatible bucket)
# ============================================================
# Instagram downloads Reels from an HTTPS URL. Soc_bot uploads the LOCAL video to this private
# bucket, gives Instagram a short-lived presigned URL, and deletes the object afterwards.
# Works with AWS S3 (set REGION), Cloudflare R2 / MinIO (set ENDPOINT, https only).
# Keep the bucket PRIVATE; add a lifecycle rule expiring instagram/temp/ after 1 day.
# Provider: auto (recommended: TempFile.org for videos up to 99 MB, a Cloudflare Quick Tunnel for larger
# ones, S3 only if cloudflared is missing; no fallback after a failure), s3 (default when unset, private
# bucket), tempfile (PUBLIC temporary host TempFile.org, no credentials, max 100 MB), cloudflare_tunnel
# (serves the local file through a temporary trycloudflare.com URL; nothing uploaded; needs cloudflared)
# or 0x0 (PUBLIC host 0x0.st; uploads currently disabled).
# Public hosts: the video leaves your computer and anyone with the link can download it until deleted.
# Don't use public hosts for AUTO/bulk publishing (their terms forbid automated bulk uploads).
MEDIA_STORAGE_PROVIDER=s3
# --- tempfile / auto: 1, 6, 24 or 48 ---
MEDIA_STORAGE_TEMPFILE_EXPIRY_HOURS=1
# --- auto only: stay this many MB below a provider's size limit ---
MEDIA_STORAGE_AUTO_MARGIN_MB=1
# --- cloudflare_tunnel / auto: Cloudflare Quick Tunnel (no account, API key or domain) ---
# Cloudflare documents Quick Tunnels for testing/development only (no uptime guarantee).
# Install: winget install --id Cloudflare.cloudflared   (Soc_bot never downloads executables)
CLOUDFLARED_PATH=cloudflared
# Tunnel start + public-DNS readiness; keep above 60 s (trycloudflare.com negative-cache TTL).
CLOUDFLARE_TUNNEL_STARTUP_TIMEOUT_SECONDS=90
# Random URL token size in bytes (16..64) and the local bind address (must stay 127.0.0.1).
CLOUDFLARE_MEDIA_TOKEN_BYTES=16
CLOUDFLARE_MEDIA_HOST=127.0.0.1
# Instagram: longest status-polling window in minutes (large videos get extra minutes automatically).
INSTAGRAM_MAX_POLL_MINUTES=15
# --- 0x0 only ---
MEDIA_STORAGE_0X0_URL=https://0x0.st
MEDIA_STORAGE_0X0_EXPIRES_HOURS=1
# --- s3 only ---
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
# Presigned URL lifetime in seconds (60..604800).
MEDIA_STORAGE_PRESIGNED_URL_TTL=900
# Delete the temporary object after each Instagram publish attempt.
MEDIA_STORAGE_DELETE_AFTER_PUBLISH=true

# ============================================================
# APPLICATION
# ============================================================
LOG_LEVEL=INFO
DRY_RUN=false

# Optional: callback host/port for platforms without a fixed *_REDIRECT_URI.
# Port 0 (default) = OS picks a free port for each OAuth flow. Keep the host on loopback.
# OAUTH_CALLBACK_HOST=127.0.0.1
# OAUTH_CALLBACK_PORT=0

# Optional: Max concurrent uploads (default 3)
# MAX_CONCURRENT_UPLOADS=3

# Optional: Video validation limits (bytes)
# MAX_VIDEO_SIZE_INSTAGRAM=4294967296
# MAX_VIDEO_SIZE_TIKTOK=4294967296
# MAX_VIDEO_SIZE_YOUTUBE=274877906944